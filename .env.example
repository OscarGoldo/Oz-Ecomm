# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret. Server-only. Used by the seed script and admin server actions.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────────────────────
# Base URL of the app (used for magic-link redirects and public store links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (optional) ─────────────────────────────────────────────────────────
# Resend API key for "new order" notifications to store owners.
# If unset, order emails are silently skipped (everything else works).
# https://resend.com → API Keys
RESEND_API_KEY=
# Verified sender. For testing you can use "Tiendify <onboarding@resend.dev>".
# In production use an address on a domain you verified in Resend.
EMAIL_FROM=Tiendify <onboarding@resend.dev>

# ── PayPal (optional) ────────────────────────────────────────────────────────
# Una sola cuenta de plataforma, usada para dos cosas distintas:
#   1. El checkout online de las tiendas (la plata entra aquí y después se le
#      paga a cada tienda desde /super/pagos).
#   2. El cobro del plan Pro a los comerciantes (/panel/plan) — ese pago sí es
#      tuyo y no genera payout.
# Si faltan, los botones de PayPal simplemente no aparecen y todo lo demás
# sigue funcionando con los pagos por comprobante.
# https://developer.paypal.com → Apps & Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Secreto. Server-only, nunca llega al navegador.
PAYPAL_SECRET=
# "false" para cobrar de verdad. Cualquier otro valor (o vacío) = sandbox.
PAYPAL_SANDBOX=true

# ── PayPal: suscripción recurrente (opcional) ────────────────────────────────
# Los crea `npx tsx --env-file=.env.local scripts/paypal-setup.ts`, que los
# imprime listos para pegar. Son DISTINTOS en sandbox y en live: correr el
# script una vez por entorno.
# Sin estos tres, /panel/plan cae al cobro único por PayPal (que funciona, pero
# no se renueva solo). Nada se rompe.
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_YEARLY=
# Id del webhook. Sin esto NO se verifica la firma y todo webhook se rechaza,
# que es el comportamiento seguro: preferimos no cobrar a que alguien se
# regale el plan con un POST.
PAYPAL_WEBHOOK_ID=

# ── Cron (BCV rates) ─────────────────────────────────────────────────────────
# Secret that protects the daily BCV-rate cron route (/api/cron/bcv).
# Set the same value in Vercel; Vercel sends it as a Bearer token to the cron.
CRON_SECRET=
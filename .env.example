# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret. Server-only. Used by the seed script and admin server actions.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ──────────────────────────────────────────────────────────────────────
# Base URL of the app (used for magic-link redirects and public store links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (optional) ─────────────────────────────────────────────────────────
# Resend API key for "new order" notifications to store owners.
# If unset, order emails are silently skipped (everything else works).
# https://resend.com → API Keys
RESEND_API_KEY=
# Verified sender. For testing you can use "Tiendify <onboarding@resend.dev>".
# In production use an address on a domain you verified in Resend.
EMAIL_FROM=Tiendify <onboarding@resend.dev>

# ── PayPal (optional) ────────────────────────────────────────────────────────
# Una sola cuenta de plataforma, usada para dos cosas distintas:
#   1. El checkout online de las tiendas (la plata entra aquí y después se le
#      paga a cada tienda desde /super/pagos).
#   2. El cobro del plan Pro a los comerciantes (/panel/plan) — ese pago sí es
#      tuyo y no genera payout.
# Si faltan, los botones de PayPal simplemente no aparecen y todo lo demás
# sigue funcionando con los pagos por comprobante.
# https://developer.paypal.com → Apps & Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Secreto. Server-only, nunca llega al navegador.
PAYPAL_SECRET=
# "false" para cobrar de verdad. Cualquier otro valor (o vacío) = sandbox.
PAYPAL_SANDBOX=true

# ── PayPal: suscripción recurrente (opcional) ────────────────────────────────
# Los crea `npx tsx --env-file=.env.local scripts/paypal-setup.ts`, que los
# imprime listos para pegar. Son DISTINTOS en sandbox y en live: correr el
# script una vez por entorno.
# Sin estos tres, /panel/plan cae al cobro único por PayPal (que funciona, pero
# no se renueva solo). Nada se rompe.
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_YEARLY=
# Id del webhook. Sin esto NO se verifica la firma y todo webhook se rechaza,
# que es el comportamiento seguro: preferimos no cobrar a que alguien se
# regale el plan con un POST.
PAYPAL_WEBHOOK_ID=

# ── Stripe (opcional) ────────────────────────────────────────────────────────
# Misma idea que PayPal: UNA cuenta de plataforma (la de Canadá) para las dos
# cosas que se cobran con tarjeta:
#   1. El checkout de las tiendas (la plata entra aquí y se le paga a cada
#      tienda desde /super/pagos).
#   2. El plan Pro de los comerciantes (/panel/plan) — ese pago sí es tuyo.
# Sin STRIPE_SECRET_KEY no aparece ningún botón de tarjeta y todo lo demás
# sigue igual.
# https://dashboard.stripe.com → Developers → API keys
# Server-only: no hay clave pública porque el checkout es una redirección.
STRIPE_SECRET_KEY=
# Clave PÚBLICA. Es la única de Stripe que va al navegador, y es necesaria:
# sin ella no se puede pintar el formulario de tarjeta dentro del checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secreto de firma del endpoint <NEXT_PUBLIC_APP_URL>/api/stripe/webhook.
# Sin esto NO se verifica la firma y todo webhook se rechaza, que es el
# comportamiento seguro: preferimos no confirmar pedidos a que alguien se
# regale uno con un POST. Los pedidos con tarjeta quedan "esperando pago".
STRIPE_WEBHOOK_SECRET=
# Precios recurrentes del plan Pro. Los crea
# `npx tsx --env-file=.env.local scripts/stripe-setup.ts`, que los imprime
# listos para pegar. Son DISTINTOS en test y en live.
# Sin estos dos, /panel/plan cobra el plan una sola vez (funciona, pero no se
# renueva solo). Nada se rompe.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── Cron (BCV rates) ─────────────────────────────────────────────────────────
# Secret that protects the daily BCV-rate cron route (/api/cron/bcv).
# Set the same value in Vercel; Vercel sends it as a Bearer token to the cron.
CRON_SECRET=

# ── Monitoreo de errores (opcional pero recomendado en producción) ───────────
# DSN del proyecto de Sentry. Solo se usa en el SERVIDOR: el SDK del navegador
# no se carga a propósito, para no sumarle ~35 kB al comprador que entra con
# datos móviles. Ver src/instrumentation.ts.
# Sin esta variable no se inicializa nada y los errores igual quedan en los
# logs de Vercel vía src/lib/report-error.ts.
SENTRY_DSN=

# ── WhatsApp Cloud API (opcional) ────────────────────────────────────────────
# Aviso al comerciante apenas entra un pedido. Sin esto, el aviso inmediato
# depende de que el cliente toque "Avisar a la tienda" en la confirmación.
#
# OJO: Meta no deja mandar texto libre a quien no te escribió en las últimas
# 24 h. El aviso va como PLANTILLA aprobada, que hay que crear en Meta Business
# Manager con TRES variables, en este orden:
#   {{1}} número de pedido · {{2}} nombre de la tienda · {{3}} total
# Ej: "Nuevo pedido #{{1}} en {{2}} por {{3}}. Míralo en tu panel."
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=
# Código de idioma de la plantilla. Por defecto es_ES.
WHATSAPP_TEMPLATE_LANG=es_ES
